# Copy thành starter/.env và điền giá trị. Không commit file .env.

# Vector store Day 6 (Postgres + pgvector chạy bằng Docker, chỉ local)
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# LLM cho agent (OpenAI Chat Completions, có tool calling)
PROVIDER=openai
MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Giá USD / 1 triệu token, dùng để tính chi phí trong trace (gpt-5.4-mini, tra ngày 2026-11-16)
PRICE_INPUT_PER_1M=0.75
PRICE_OUTPUT_PER_1M=4.50
